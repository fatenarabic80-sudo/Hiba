@model IReadOnlyList<CategoryDto>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-heritage"><i class="bi bi-plus-lg"></i> New Category</a>
</div>

<div class="card">
    <table class="table align-middle mb-0">
        <thead><tr><th>Name</th><th>Description</th><th>Products</th><th></th></tr></thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>@category.ProductCount</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="4" class="text-center text-muted py-4">No categories yet.</td></tr>
            }
        </tbody>
    </table>
</div>
