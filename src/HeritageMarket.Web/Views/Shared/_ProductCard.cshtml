@model ProductListItemDto
<div class="col">
    <div class="product-card">
        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="product-media d-block">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder-product.svg" : Model.ImageUrl)" alt="@Model.Name" />
        </a>
        <div class="product-info">
            <div class="product-country">@Model.CountryName</div>
            <h6 class="mb-1">
                <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
            </h6>
            <p class="text-muted small mb-2">@Model.CategoryName</p>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="rating-stars small">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= Math.Round(Model.AverageRating) ? "bi-star-fill" : "bi-star")"></i>
                    }
                </span>
                <span class="price-tag">@Model.Price.ToString("C")</span>
            </div>
            @if (Model.StockQuantity <= 0)
            {
                <span class="badge bg-secondary w-100 py-2">Out of stock</span>
            }
            else
            {
                <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-heritage btn-sm w-100">
                    <i class="bi bi-bag-plus"></i> View Product
                </a>
            }
        </div>
    </div>
</div>
