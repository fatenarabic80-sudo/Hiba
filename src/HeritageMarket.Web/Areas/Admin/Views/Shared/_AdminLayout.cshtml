<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - Heritage Marketplace</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand navbar-dark bg-heritage">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-globe-americas"></i> Heritage Marketplace</a>
            <span class="navbar-text text-white">Admin Panel</span>
            <div class="d-flex align-items-center gap-2">
                <a class="btn btn-sm btn-outline-light" asp-area="" asp-controller="Home" asp-action="Index">Back to Store</a>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-light dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i> @User.Identity?.Name
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Profile" asp-action="Index">My Profile</a></li>
                        <li><hr class="dropdown-divider" /></li>
                        <li>
                            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/Admin/Account/Login" method="post">
                                <button type="submit" class="dropdown-item">Logout</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </nav>

    <div class="d-flex">
        <div class="admin-sidebar p-3" style="width:230px">
            <ul class="nav nav-pills flex-column gap-1">
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i> Products</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i> Categories</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Countries" asp-action="Index"><i class="bi bi-flag"></i> Countries</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Orders" asp-action="Index"><i class="bi bi-receipt"></i> Orders</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Users" asp-action="Index"><i class="bi bi-people"></i> Users</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="BookRequests" asp-action="Index"><i class="bi bi-book"></i> Book Requests</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="bi bi-graph-up"></i> Reports</a></li>
                <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-gear"></i> My Profile</a></li>
            </ul>
        </div>
        <div class="flex-fill p-4">
            @{
                var statusMessage = TempData["StatusMessage"] as string;
                var errorMessage = TempData["ErrorMessage"] as string;
            }
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert-success alert-dismissible fade show">@statusMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show">@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            <h3 class="mb-4">@ViewData["Title"]</h3>
            @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
