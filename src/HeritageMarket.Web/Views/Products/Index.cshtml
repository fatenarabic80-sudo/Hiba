@model ProductCatalogViewModel
@{
    ViewData["Title"] = "Shop";
}

<div class="page-banner">
    <div class="container">
        <div class="crumbs mb-1"><a asp-controller="Home" asp-action="Index">Home</a> / Shop</div>
        <h1>Shop All Heritage Products</h1>
    </div>
</div>

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="filters-card">
                <h5 class="mb-3" style="font-family:var(--serif);">Filters</h5>
                <form method="get" asp-action="Index">
                    <div class="mb-3">
                        <label class="form-label">Search</label>
                        <input type="text" class="form-control" name="searchTerm" value="@Model.Filter.SearchTerm" placeholder="Product name or SKU" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select class="form-select" name="categoryId">
                            <option value="">All Categories</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id" selected="@(Model.Filter.CategoryId == category.Id)">@category.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Country</label>
                        <select class="form-select" name="countryId">
                            <option value="">All Countries</option>
                            @foreach (var regionGroup in Model.Countries.GroupBy(c => c.Region).OrderBy(g => g.Key))
                            {
                                <optgroup label="@regionGroup.Key">
                                    @foreach (var country in regionGroup)
                                    {
                                        <option value="@country.Id" selected="@(Model.Filter.CountryId == country.Id)">@country.Name</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-heritage w-100">Apply Filters</button>
                    <a asp-action="Index" class="btn btn-link w-100 text-center d-block mt-1">Clear</a>
                </form>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">@Model.Products.TotalCount product(s)</span>
            </div>

            @if (Model.Products.Items.Count == 0)
            {
                <div class="alert alert-info">No products matched your filters.</div>
            }
            else if (ViewData["IsWearCategory"] as bool? == true)
            {
                var genderOrder = new[] { "Women", "Men", "Kids" };
                var genderGroups = Model.Products.Items
                    .GroupBy(p => p.Gender ?? "Other")
                    .OrderBy(g => Array.IndexOf(genderOrder, g.Key) is var idx && idx >= 0 ? idx : genderOrder.Length);

                foreach (var group in genderGroups)
                {
                    <div class="mb-4">
                        <h4 class="mb-3" style="font-family:var(--serif); color:var(--brown);">@(group.Key == "Other" ? "More" : group.Key)</h4>
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                            @foreach (var product in group)
                            {
                                <partial name="_ProductCard" model="product" />
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4 mb-4">
                    @foreach (var product in Model.Products.Items)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>

                ViewData["RouteValues"] = new Dictionary<string, string?>
                {
                    ["searchTerm"] = Model.Filter.SearchTerm,
                    ["categoryId"] = Model.Filter.CategoryId?.ToString(),
                    ["countryId"] = Model.Filter.CountryId?.ToString()
                };
                <partial name="_Pagination" model="Model.Products" />
            }
        </div>
    </div>
</div>

@if (ViewData["IsBooksCategory"] as bool? == true)
{
    @section Scripts {
        <script src="~/js/books-greeting.js" asp-append-version="true"></script>
    }
}
