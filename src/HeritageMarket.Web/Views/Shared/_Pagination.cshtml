@model PagedResult<ProductListItemDto>
@{
    var routeValues = ViewData["RouteValues"] as Dictionary<string, string?> ?? new Dictionary<string, string?>();
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Product pages">
        <ul class="pagination justify-content-center">
            @for (var page = 1; page <= Model.TotalPages; page++)
            {
                var values = new Dictionary<string, string?>(routeValues) { ["pageNumber"] = page.ToString() };
                <li class="page-item @(page == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="values">@(page)</a>
                </li>
            }
        </ul>
    </nav>
}
