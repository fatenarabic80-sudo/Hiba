@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="page-banner">
    <div class="container">
        <div class="crumbs mb-1"><a asp-controller="Home" asp-action="Index">Home</a> / <a asp-controller="Cart" asp-action="Index">Cart</a> / Checkout</div>
        <h1>Checkout</h1>
    </div>
</div>

<div class="container mt-4">
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Shipping Details</h5>
                <form asp-controller="Checkout" asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label"></label>
                        <input asp-for="ShippingAddress" class="form-control" />
                        <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ShippingCity" class="form-label"></label>
                        <input asp-for="ShippingCity" class="form-control" />
                        <span asp-validation-for="ShippingCity" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-heritage">Place Order</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title mb-3">Order Summary</h5>
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var item in Model.Cart.Items)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@item.ProductName &times; @item.Quantity</span>
                            <span>@item.LineTotal.ToString("C")</span>
                        </li>
                    }
                </ul>
                <div class="d-flex justify-content-between">
                    <span class="fw-semibold">Total</span>
                    <span class="fw-bold text-heritage fs-5">@Model.Cart.Total.ToString("C")</span>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
