@model PagedResult<OrderListItemDto>
@{
    ViewData["Title"] = "Orders";
    var currentStatus = ViewData["StatusFilter"] as OrderStatus?;
}

<form class="d-flex gap-2 mb-3" method="get">
    <select name="status" class="form-select" style="max-width:220px" onchange="this.form.submit()">
        <option value="">All Statuses</option>
        @foreach (var status in Enum.GetValues<OrderStatus>())
        {
            <option value="@status" selected="@(currentStatus == status)">@status</option>
        }
    </select>
</form>

<div class="card">
    <table class="table align-middle mb-0">
        <thead><tr><th>Order #</th><th>Date</th><th>Items</th><th>Status</th><th>Total</th><th></th></tr></thead>
        <tbody>
            @foreach (var order in Model.Items)
            {
                <tr>
                    <td>#@order.Id</td>
                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                    <td>@order.ItemCount</td>
                    <td><span class="badge bg-warning text-dark">@order.Status</span></td>
                    <td>@order.TotalAmount.ToString("C")</td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No orders found.</td></tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (var page = 1; page <= Model.TotalPages; page++)
            {
                <li class="page-item @(page == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(page)" asp-route-status="@currentStatus">@(page)</a>
                </li>
            }
        </ul>
    </nav>
}
