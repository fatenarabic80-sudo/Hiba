@model PagedResult<ProductListItemDto>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between mb-3">
    <form class="d-flex gap-2" method="get">
        <input type="text" name="search" class="form-control" placeholder="Search by name or SKU" value="@ViewData["Search"]" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </form>
    <a asp-action="Create" class="btn btn-heritage"><i class="bi bi-plus-lg"></i> New Product</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th></th><th>Name</th><th>Category</th><th>Country</th><th>Price</th><th>Stock</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Items)
                {
                    <tr>
                        <td><img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder-product.svg" : product.ImageUrl)" width="40" height="40" style="object-fit:cover" class="rounded" /></td>
                        <td>@product.Name</td>
                        <td>@product.CategoryName</td>
                        <td>@product.CountryName</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>
                            @if (product.StockQuantity <= 5)
                            {
                                <span class="badge bg-danger">@product.StockQuantity</span>
                            }
                            else
                            {
                                @product.StockQuantity
                            }
                        </td>
                        <td></td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this product?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No products found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination">
            @for (var page = 1; page <= Model.TotalPages; page++)
            {
                <li class="page-item @(page == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@(page)" asp-route-search="@ViewData["Search"]">@(page)</a>
                </li>
            }
        </ul>
    </nav>
}
