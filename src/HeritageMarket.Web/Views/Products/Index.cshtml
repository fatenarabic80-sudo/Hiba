@model ProductCatalogViewModel
@{
    ViewData["Title"] = "Shop";
}

<div class="page-banner">
    <div class="container">
        <div class="crumbs mb-1"><a asp-controller="Home" asp-action="Index">Home</a> / Shop</div>
        <h1>Shop All Heritage Products</h1>
    </div>
</div>

@if (!Model.Filter.CategoryId.HasValue)
{
    var slides = new (string ImageUrl, string Title, string Sub)[]
    {
        ("/images/curated/home-lebanon-jug.jpg", "Home & Decoration", "Heritage-inspired pieces for every corner of your space."),
        ("https://loremflickr.com/1400/420/jewelry,artisan?lock=302", "Accessories", "Traditional accessories with a modern edge."),
        ("/images/curated/wear-turkey-kaftan.jpg", "Wear & Traditional Clothing", "Women's, men's, and kids' styles from around the world."),
        ("https://loremflickr.com/1400/420/phonecase,pattern?lock=304", "Phone Covers", "Carry a piece of heritage in your pocket."),
        ("https://loremflickr.com/1400/420/books,library?lock=305", "Heritage Books", "Timeless stories from celebrated authors worldwide.")
    };
    <div class="container mt-4">
        <div id="shopCarousel" class="carousel slide shop-carousel mb-4" data-bs-ride="carousel" data-bs-interval="3500">
            <div class="carousel-indicators">
                @for (var i = 0; i < slides.Length; i++)
                {
                    <button type="button" data-bs-target="#shopCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)"></button>
                }
            </div>
            <div class="carousel-inner">
                @for (var i = 0; i < slides.Length; i++)
                {
                    var slide = slides[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <img src="@slide.ImageUrl" alt="@slide.Title" />
                        <div class="carousel-caption">
                            <h5>@slide.Title</h5>
                            <p class="d-none d-md-block">@slide.Sub</p>
                        </div>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#shopCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#shopCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
}

<div class="container mt-4">
    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="filters-card">
                <h5 class="mb-3" style="font-family:var(--serif);">Filters</h5>
                <form method="get" asp-action="Index">
                    <div class="mb-3">
                        <label class="form-label">Search</label>
                        <input type="text" class="form-control" name="searchTerm" value="@Model.Filter.SearchTerm" placeholder="Product name or SKU" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <select class="form-select" name="categoryId">
                            <option value="">All Categories</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id" selected="@(Model.Filter.CategoryId == category.Id)">@category.Name</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label d-block">Country</label>
                        <div class="country-picker">
                            @{ var allActive = !Model.Filter.CountryId.HasValue; }
                            <label class="country-pick-item @(allActive ? "active" : "")">
                                <input type="radio" name="countryId" value="" class="visually-hidden" checked="@allActive" onchange="this.form.submit()" />
                                <span class="country-pick-thumb country-pick-thumb-all"><i class="bi bi-globe2"></i></span>
                                <span class="country-pick-name">All</span>
                            </label>
                            @foreach (var regionGroup in Model.Countries.GroupBy(c => c.Region).OrderBy(g => g.Key))
                            {
                                <div class="country-pick-region">@regionGroup.Key</div>
                                @foreach (var country in regionGroup)
                                {
                                    var isActive = Model.Filter.CountryId == country.Id;
                                    <label class="country-pick-item @(isActive ? "active" : "")">
                                        <input type="radio" name="countryId" value="@country.Id" class="visually-hidden" checked="@isActive" onchange="this.form.submit()" />
                                        <span class="country-pick-thumb">
                                            <img src="@(string.IsNullOrEmpty(country.LandmarkImageUrl) ? (country.FlagImageUrl ?? "/images/placeholder-product.svg") : country.LandmarkImageUrl)" alt="@country.Name" />
                                        </span>
                                        <span class="country-pick-name">@country.Name</span>
                                    </label>
                                }
                            }
                        </div>
                    </div>
                    <button type="submit" class="btn btn-heritage w-100">Apply Filters</button>
                    <a asp-action="Index" class="btn btn-link w-100 text-center d-block mt-1">Clear</a>
                </form>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-muted">@Model.Products.TotalCount product(s)</span>
            </div>

            @if (Model.Products.Items.Count == 0)
            {
                <div class="alert alert-info">No products matched your filters.</div>
            }
            else if (ViewData["IsWearCategory"] as bool? == true)
            {
                var genderOrder = new[] { "Women", "Men", "Kids" };
                var genderGroups = Model.Products.Items
                    .GroupBy(p => p.Gender ?? "Other")
                    .OrderBy(g => Array.IndexOf(genderOrder, g.Key) is var idx && idx >= 0 ? idx : genderOrder.Length);

                foreach (var group in genderGroups)
                {
                    <div class="mb-4">
                        <h4 class="mb-3" style="font-family:var(--serif); color:var(--brown);">@(group.Key == "Other" ? "More" : group.Key)</h4>
                        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                            @foreach (var product in group)
                            {
                                <partial name="_ProductCard" model="product" />
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4 mb-4">
                    @foreach (var product in Model.Products.Items)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>

                ViewData["RouteValues"] = new Dictionary<string, string?>
                {
                    ["searchTerm"] = Model.Filter.SearchTerm,
                    ["categoryId"] = Model.Filter.CategoryId?.ToString(),
                    ["countryId"] = Model.Filter.CountryId?.ToString()
                };
                <partial name="_Pagination" model="Model.Products" />
            }
        </div>
    </div>
</div>

@if (ViewData["IsBooksCategory"] as bool? == true)
{
    @section Scripts {
        <script src="~/js/books-greeting.js" asp-append-version="true"></script>
    }
}
