@using System.Text.Json
@model BooksGateViewModel
@{
    ViewData["Title"] = "Heritage Books";
}

<div class="page-banner">
    <div class="container">
        <div class="crumbs mb-1"><a asp-controller="Home" asp-action="Index">Home</a> / Heritage Books</div>
        <h1>Heritage Books</h1>
    </div>
</div>

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 text-center">
            <i class="bi bi-book text-heritage" style="font-size:2.5rem;"></i>
            <p class="text-muted mt-3">
                Heritage Books unlock through a short chat with our Heritage Guide — look for the chat
                bubble in the bottom-right corner. It should have opened automatically.
            </p>
            <button type="button" class="btn btn-outline-heritage btn-sm" onclick="document.getElementById('aiOpenBtn').click();">
                Open the Heritage Guide
            </button>
        </div>
    </div>
</div>

<script id="books-gate-data" type="application/json">
@Html.Raw(JsonSerializer.Serialize(new
{
    isAuthenticated = Model.IsAuthenticated,
    status = Model.Status?.ToString(),
    adminNote = Model.AdminNote,
    countries = Model.Countries.Select(c => c.Name).ToArray()
}))
</script>

@section Scripts {
    <script src="~/js/books-gate.js" asp-append-version="true"></script>
}
