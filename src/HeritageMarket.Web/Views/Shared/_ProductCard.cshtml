@model ProductListItemDto
<div class="col">
    <div class="card product-card h-100">
        <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder-product.svg" : Model.ImageUrl)" class="card-img-top" alt="@Model.Name" />
        </a>
        <div class="card-body d-flex flex-column">
            <span class="badge bg-light text-heritage border mb-2 align-self-start">@Model.CountryName</span>
            <h6 class="card-title mb-1">
                <a class="text-decoration-none text-dark" asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
            </h6>
            <p class="text-muted small mb-2">@Model.CategoryName</p>
            <div class="rating-stars small mb-2">
                @for (var i = 1; i <= 5; i++)
                {
                    <i class="bi @(i <= Math.Round(Model.AverageRating) ? "bi-star-fill" : "bi-star")"></i>
                }
            </div>
            <div class="mt-auto d-flex justify-content-between align-items-center">
                <span class="fw-bold text-heritage">@Model.Price.ToString("C")</span>
                @if (Model.StockQuantity <= 0)
                {
                    <span class="badge bg-secondary">Out of stock</span>
                }
                else
                {
                    <a asp-controller="Products" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-heritage">View</a>
                }
            </div>
        </div>
    </div>
</div>
