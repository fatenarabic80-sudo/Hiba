@model CartDto
@{
    ViewData["Title"] = "Your Cart";
}

<div class="page-banner">
    <div class="container">
        <div class="crumbs mb-1"><a asp-controller="Home" asp-action="Index">Home</a> / Cart</div>
        <h1>Your Shopping Cart</h1>
    </div>
</div>

<div class="container mt-4">
    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info">
            Your cart is empty. <a asp-controller="Products" asp-action="Index">Continue shopping</a>.
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-row d-flex align-items-center gap-3 py-3 border-bottom">
                        <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "/images/placeholder-product.svg" : item.ProductImageUrl)" alt="@item.ProductName" />
                        <div class="flex-grow-1">
                            <a asp-controller="Products" asp-action="Details" asp-route-id="@item.ProductId" class="fw-semibold text-decoration-none" style="color:var(--brown)">@item.ProductName</a>
                            @if (!string.IsNullOrEmpty(item.SelectedSize))
                            {
                                <span class="badge bg-light text-dark border ms-1">Size: @item.SelectedSize</span>
                            }
                            <div class="text-muted small">@item.UnitPrice.ToString("C") each</div>
                            <form asp-controller="Cart" asp-action="Remove" method="post" class="d-inline">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <button type="submit" class="btn btn-link btn-sm text-heritage px-0">Remove</button>
                            </form>
                        </div>
                        <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex gap-1">
                            <input type="hidden" name="cartItemId" value="@item.Id" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.AvailableStock" class="form-control form-control-sm" style="width:70px" />
                            <button type="submit" class="btn btn-sm btn-outline-heritage">Update</button>
                        </form>
                        <div class="price-tag" style="min-width:80px; text-align:right;">@item.LineTotal.ToString("C")</div>
                    </div>
                }
            </div>
            <div class="col-lg-4">
                <div class="order-summary-card">
                    <h3 class="mb-3" style="font-size:18px;">Order Summary</h3>
                    <div class="d-flex justify-content-between mb-2"><span class="text-muted">Subtotal</span><span>@Model.Total.ToString("C")</span></div>
                    <div class="d-flex justify-content-between fw-bold border-top pt-2 mt-2">
                        <span>Total</span>
                        <span class="text-heritage fs-5">@Model.Total.ToString("C")</span>
                    </div>
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-heritage w-100 mt-3">Proceed to Checkout</a>
                </div>
            </div>
        </div>
    }
</div>
