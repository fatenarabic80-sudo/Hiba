@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="container">
    @{
        var heroBgImages = new[]
        {
            "/images/curated/wear-turkey-kaftan.jpg",
            "https://loremflickr.com/1800/900/jewelry,artisan?lock=501",
            "/images/curated/home-lebanon-jug.jpg",
            "https://loremflickr.com/1800/900/phonecase,pattern?lock=503",
            "https://loremflickr.com/1800/900/books,library?lock=504"
        };
    }
    <section class="hero-banner hero-banner-rotating mt-4 mb-5" id="heroRotator">
        @for (var i = 0; i < heroBgImages.Length; i++)
        {
            <div class="hero-bg-layer @(i == 0 ? "active" : "")" style="background-image:url('@heroBgImages[i]');"></div>
        }
        <div style="max-width:620px; position:relative; z-index:2;">
            <p class="eyebrow">Product &middot; Culture &middot; Story</p>
            <h1>Discover Heritage.<br />Wear Culture. Bring <em>Tradition</em> Home.</h1>
            <div class="d-flex gap-2 flex-wrap mt-4">
                <a asp-controller="Products" asp-action="Index" class="btn btn-heritage btn-lg">Explore Products</a>
                <a href="#stories" class="btn btn-ghost-cream btn-lg">Explore Heritage Stories</a>
            </div>
            <div class="hero-stats">
                <div><strong>@Model.Countries.Count</strong><span>Countries</span></div>
                <div><strong>@Model.Categories.Count</strong><span>Categories</span></div>
                <div><strong>@Model.FeaturedProducts.Count+</strong><span>Featured Pieces</span></div>
            </div>
        </div>
    </section>

    <div class="d-flex align-items-center justify-content-center gap-2 mb-5 py-2 px-3 rounded-pill mx-auto" style="max-width:fit-content; background:var(--cream-2); border:1px solid var(--line);">
        <i class="bi bi-truck text-heritage"></i>
        <span class="small fw-semibold" style="color:var(--brown);">We deliver across all of Lebanon 🇱🇧</span>
    </div>

    <section class="mb-5">
        <div class="section-head d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <p class="eyebrow">Explore by Heritage</p>
                <h2 class="mb-0">Shop the world, one culture at a time</h2>
            </div>
            <p class="sub mb-0">@Model.Countries.Count countries across four regions.</p>
        </div>
        @foreach (var region in Model.Countries.GroupBy(c => c.Region).OrderBy(g => g.Key))
        {
            <div class="region-block mb-4" id="region-@(region.Key.Replace(" ", ""))">
                <div class="region-block-head">
                    <h4>@region.Key</h4>
                    <span class="count">@region.Count() countries</span>
                </div>
                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
                    @foreach (var country in region)
                    {
                        <div class="col">
                            <a class="country-card" asp-controller="Products" asp-action="Country" asp-route-id="@country.Id">
                                <img src="@(!string.IsNullOrEmpty(country.LandmarkImageUrl) ? country.LandmarkImageUrl : (!string.IsNullOrEmpty(country.FlagImageUrl) ? country.FlagImageUrl : "/images/placeholder-product.svg"))" alt="@country.Name" />
                                <div class="info">
                                    <h4>@country.Name</h4>
                                    <span class="link">Explore Heritage &rarr;</span>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </section>

    <section class="mb-5">
        <div class="section-head d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <p class="eyebrow">Explore by Category</p>
                <h2>Every category tells a different chapter of heritage</h2>
            </div>
            <p class="sub mb-0">From the home to the wardrobe to the bookshelf.</p>
        </div>
        <div class="row row-cols-2 row-cols-md-4 g-3">
            @foreach (var category in Model.Categories)
            {
                <div class="col">
                    <a class="cat-card" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">
                        <img src="@(string.IsNullOrEmpty(category.IconUrl) ? "/images/placeholder-product.svg" : category.IconUrl)" alt="@category.Name" />
                        <div class="body">
                            <h3>@category.Name</h3>
                            <p>@category.ProductCount product(s)</p>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>

    <section class="mb-5">
        <div class="section-head d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
            <div>
                <p class="eyebrow">Featured</p>
                <h2 class="mb-0">Featured Products</h2>
            </div>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-heritage btn-sm">View All Products</a>
        </div>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var product in Model.FeaturedProducts)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>

    <section class="mb-5" id="stories">
        <div class="section-head mb-4">
            <p class="eyebrow">Our Signature</p>
            <h2>More Than a Product &mdash; A Story of Heritage</h2>
            <p class="sub">Every item on Heritage Market is linked to the hands, patterns, and history that made it.</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="product-card h-100">
                    <div class="product-media"><img src="https://loremflickr.com/600/420/embroidery,palestine?lock=201" alt="Tatreez embroidery" /></div>
                    <div class="p-3">
                        <p class="product-country mb-1">Palestine &middot; Tatreez</p>
                        <h5>The Art of Palestinian Embroidery</h5>
                        <p class="text-muted small">Discover the symbolism behind traditional embroidery patterns passed down through generations.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="product-card h-100">
                    <div class="product-media"><img src="https://loremflickr.com/600/420/ceramics,japan?lock=202" alt="Kintsugi ceramics" /></div>
                    <div class="p-3">
                        <p class="product-country mb-1">Japan &middot; Ceramic Repair</p>
                        <h5>Kintsugi: Beauty in Broken Things</h5>
                        <p class="text-muted small">A centuries-old Japanese repair technique that turned imperfection into an art form.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="product-card h-100">
                    <div class="product-media"><img src="https://loremflickr.com/600/420/tilework,morocco?lock=203" alt="Zellige tilework" /></div>
                    <div class="p-3">
                        <p class="product-country mb-1">Morocco &middot; Tilework</p>
                        <h5>Zellige: Morocco's Geometric Language</h5>
                        <p class="text-muted small">Inside the workshops of Fez, where artisans hand-cut tile fragments into geometric patterns.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-5">
        <div class="hero-banner" style="min-height:280px; background-image: linear-gradient(110deg, rgba(43,38,34,.7), rgba(60,74,59,.55)), url('https://loremflickr.com/1600/700/handicraft,heritage?lock=200');">
            <div style="max-width:520px;">
                <p class="eyebrow">Featured Collection</p>
                <h2 class="mb-2" style="color:#fff;">From Tradition to Your Home</h2>
                <p class="lead">Discover handcrafted pieces that carry stories, traditions, and cultural identity from
                    around the world.</p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-heritage btn-lg">Shop Heritage Collection</a>
            </div>
        </div>
    </section>

    <section class="section-cream-alt mb-5">
        <div class="section-head mb-4">
            <p class="eyebrow">The Journey</p>
            <h2>How the Marketplace Works</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="bg-white rounded p-4 h-100 border">
                    <i class="bi bi-search fs-2 text-heritage"></i>
                    <h5 class="mt-3">Discover</h5>
                    <p class="text-muted small mb-0">Explore products inspired by cultures from around the world, organized by category and origin.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white rounded p-4 h-100 border">
                    <i class="bi bi-book fs-2 text-heritage"></i>
                    <h5 class="mt-3">Learn</h5>
                    <p class="text-muted small mb-0">Discover the story and heritage behind each product before it becomes part of your life.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="bg-white rounded p-4 h-100 border">
                    <i class="bi bi-bag-check fs-2 text-heritage"></i>
                    <h5 class="mt-3">Shop</h5>
                    <p class="text-muted small mb-0">Purchase unique heritage-inspired products and bring culture into your everyday life.</p>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (function () {
            var layers = document.querySelectorAll('#heroRotator .hero-bg-layer');
            if (layers.length < 2) return;
            var i = 0;
            setInterval(function () {
                layers[i].classList.remove('active');
                i = (i + 1) % layers.length;
                layers[i].classList.add('active');
            }, 4000);
        })();
    </script>
}
