@model IReadOnlyList<OrderListItemDto>
@{
    ViewData["Title"] = "My Orders";
}

<h2 class="mb-4">My Orders</h2>

@if (Model.Count == 0)
{
    <div class="alert alert-info">You haven't placed any orders yet. <a asp-controller="Products" asp-action="Index">Start shopping</a>.</div>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Products</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td class="small text-muted">@string.Join(", ", order.ProductNames)</td>
                        <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                        <td>@order.ItemCount</td>
                        <td><span class="badge bg-warning text-dark">@order.Status</span></td>
                        <td>@order.TotalAmount.ToString("C")</td>
                        <td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
