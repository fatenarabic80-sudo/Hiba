@model IReadOnlyList<BookAccessRequestDto>
@{
    ViewData["Title"] = "Book Requests";
    var pending = Model.Where(r => r.Status == BookAccessStatus.Pending).ToList();
    var reviewed = Model.Where(r => r.Status != BookAccessStatus.Pending).ToList();
}

<p class="text-muted small mb-3">
    Customers answer the Heritage Guide's two questions and get instant access — no waiting on
    review, so interest doesn't cool off while they wait. This page is a record of who asked for
    what (handy for seeing which countries' books customers want most), and you can still revoke a
    customer's access below if you need to.
</p>

@if (pending.Count > 0)
{
    <h5 class="mb-3">Awaiting Review (@pending.Count)</h5>
    <div class="card mb-4">
        <table class="table align-middle mb-0">
            <thead><tr><th>Customer</th><th>Reason</th><th>Preferred Country</th><th>Requested</th><th></th></tr></thead>
            <tbody>
                @foreach (var request in pending)
                {
                    <tr>
                        <td>@request.RequesterName</td>
                        <td style="max-width:320px;">@request.Reason</td>
                        <td>@request.PreferredCountry</td>
                        <td>@request.RequestedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <form asp-action="Approve" method="post" class="d-inline">
                                <input type="hidden" name="Id" value="@request.Id" />
                                <button type="submit" class="btn btn-sm btn-heritage">Approve</button>
                            </form>
                            <form asp-action="Reject" method="post" class="d-inline">
                                <input type="hidden" name="Id" value="@request.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h5 class="mb-3">All Requests</h5>
<div class="card">
    <table class="table align-middle mb-0">
        <thead><tr><th>Customer</th><th>Reason</th><th>Preferred Country</th><th>Status</th><th>Requested</th><th></th></tr></thead>
        <tbody>
            @foreach (var request in reviewed)
            {
                <tr>
                    <td>@request.RequesterName</td>
                    <td style="max-width:280px;">@request.Reason</td>
                    <td>@request.PreferredCountry</td>
                    <td>
                        @if (request.Status == BookAccessStatus.Approved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Revoked</span>
                        }
                    </td>
                    <td>@request.RequestedAt.ToString("MMM dd, yyyy")</td>
                    <td class="text-end">
                        @if (request.Status == BookAccessStatus.Approved)
                        {
                            <form asp-action="Reject" method="post" class="d-inline" onsubmit="return confirm('Revoke this customer\'s access to Heritage Books?');">
                                <input type="hidden" name="Id" value="@request.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Revoke Access</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="Approve" method="post" class="d-inline">
                                <input type="hidden" name="Id" value="@request.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Restore Access</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (reviewed.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-4">No requests yet.</td></tr>
            }
        </tbody>
    </table>
</div>
