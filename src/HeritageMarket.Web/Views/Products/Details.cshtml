@model ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var product = Model.Product;
}

<div class="page-banner">
    <div class="container">
        <div class="crumbs">
            <a asp-controller="Home" asp-action="Index">Home</a> /
            <a asp-controller="Products" asp-action="Index">Shop</a> /
            <span>@product.Name</span>
        </div>
    </div>
</div>

<div class="container mt-4">
    <div class="row g-5">
        <div class="col-md-5">
            <div class="pd-gallery">
                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder-product.svg" : product.ImageUrl)" alt="@product.Name" />
                @{
                    var wishlistedIds = ViewData["WishlistedIds"] as HashSet<int> ?? new HashSet<int>();
                    var isWishlisted = wishlistedIds.Contains(product.Id);
                }
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <button type="button"
                            class="wish-heart-btn @(isWishlisted ? "active" : "")"
                            data-product-id="@product.Id"
                            title="@(isWishlisted ? "Remove from wishlist" : "Add to wishlist")"
                            aria-label="Toggle wishlist">
                        <i class="bi @(isWishlisted ? "bi-heart-fill" : "bi-heart")"></i>
                    </button>
                }
            </div>
        </div>
        <div class="col-md-7">
            <p class="product-country">@product.CountryName</p>
            <h1>@product.Name</h1>
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="rating-stars">
                    @for (var i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= Math.Round(product.AverageRating) ? "bi-star-fill" : "bi-star")"></i>
                    }
                </span>
                <span class="text-muted small">(@product.Reviews.Count review(s))</span>
            </div>
            <div class="pd-price mb-3">@product.Price.ToString("C")</div>
            <p class="text-muted">@product.Description</p>

            <div class="d-flex gap-4 my-3 flex-wrap">
                <div><strong class="d-block text-heritage small text-uppercase">Category</strong><span class="text-muted small">@product.CategoryName</span></div>
                <div><strong class="d-block text-heritage small text-uppercase">SKU</strong><span class="text-muted small">@product.SKU</span></div>
                <div><strong class="d-block text-heritage small text-uppercase">Origin</strong><span class="text-muted small">@product.CountryName</span></div>
                @if (!string.IsNullOrEmpty(product.Gender))
                {
                    <div><strong class="d-block text-heritage small text-uppercase">For</strong><span class="text-muted small">@product.Gender</span></div>
                }
            </div>

            @if (!string.IsNullOrEmpty(product.Sizes))
            {
                <div class="mb-3">
                    <strong class="d-block text-heritage small text-uppercase mb-2">Available Sizes</strong>
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var size in product.Sizes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="badge bg-light text-dark border px-3 py-2" style="font-weight:500;">@size</span>
                        }
                    </div>
                </div>
            }

            @if (product.StockQuantity <= 0)
            {
                <div class="alert alert-secondary">Out of stock.</div>
            }
            else
            {
                <p class="text-success"><i class="bi bi-check-circle"></i> @product.StockQuantity in stock</p>
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-2 align-items-end">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <div>
                        <label class="form-label small">Quantity</label>
                        <input type="number" name="quantity" class="form-control" value="1" min="1" max="@product.StockQuantity" style="width:100px" />
                    </div>
                    <button type="submit" class="btn btn-heritage btn-lg"><i class="bi bi-bag-plus"></i> Add to Cart</button>
                </form>
            }
        </div>
    </div>

    <ul class="nav pd-tabs mt-5 mb-4" id="pdTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#pdDesc" type="button">Description</button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-bs-toggle="tab" data-bs-target="#pdReviews" type="button">Reviews (@product.Reviews.Count)</button>
        </li>
    </ul>
    <div class="tab-content pb-5">
        <div class="tab-pane fade show active" id="pdDesc">
            <p class="text-muted" style="max-width:760px;">@product.Description</p>
        </div>
        <div class="tab-pane fade" id="pdReviews">
            <div class="row">
                <div class="col-lg-8">
                    @if (product.Reviews.Count == 0)
                    {
                        <p class="text-muted">No reviews yet. Be the first to review this product.</p>
                    }
                    else
                    {
                        foreach (var review in product.Reviews)
                        {
                            <div class="border-bottom py-3">
                                <div class="rating-stars small">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="bi @(i <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                    }
                                </div>
                                <p class="mb-1">@review.Comment</p>
                                <p class="text-muted small mb-0">@review.CreatedAt.ToString("MMM dd, yyyy")</p>
                            </div>
                        }
                    }

                    @if (Model.CanReview)
                    {
                        <h5 class="mt-4">Write a Review</h5>
                        <form asp-controller="Products" asp-action="AddReview" method="post">
                            <input type="hidden" asp-for="ReviewForm.ProductId" />
                            <div class="mb-3">
                                <label class="form-label">Rating</label>
                                <select asp-for="ReviewForm.Rating" class="form-select" style="max-width:150px">
                                    <option value="5">5 - Excellent</option>
                                    <option value="4">4 - Good</option>
                                    <option value="3">3 - Average</option>
                                    <option value="2">2 - Poor</option>
                                    <option value="1">1 - Terrible</option>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Comment</label>
                                <textarea asp-for="ReviewForm.Comment" class="form-control" rows="3"></textarea>
                            </div>
                            <button type="submit" class="btn btn-heritage">Submit Review</button>
                        </form>
                    }
                    else
                    {
                        <p class="text-muted"><a asp-area="Identity" asp-page="/Account/Login">Log in</a> to write a review.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
