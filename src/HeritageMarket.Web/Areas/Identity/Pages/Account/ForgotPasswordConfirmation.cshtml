@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <h3>Check your email</h3>
        <p class="text-muted">If an account exists for that address, a password reset link has been generated.</p>
        @if (!string.IsNullOrEmpty(Model.ResetLink))
        {
            <div class="alert alert-info text-start">
                <strong>Demo mode:</strong> no email server is configured, so here is your reset link directly:
                <br />
                <a href="@Model.ResetLink">@Model.ResetLink</a>
            </div>
        }
        <a asp-page="./Login" class="btn btn-heritage">Back to Login</a>
    </div>
</div>
